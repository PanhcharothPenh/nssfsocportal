{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npx vite build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/shift/notify-today",
      "schedule": "0 1 * * *"
    }
  ]
}
